# ==============================================================================
# ENVIRONMENT VARIABLES - IRODORI JFT-BASIC A2 MASTER PORTAL
# ==============================================================================

# 1. DATABASE (Neon Serverless PostgreSQL)
# Dapatkan dari: https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. AUTHENTICATION (Clerk)
# Dapatkan dari: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_sample_key"
CLERK_SECRET_KEY="sk_test_sample_key"
CLERK_WEBHOOK_SECRET="whsec_sample_secret"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# 3. EMAIL (Resend)
# Dapatkan dari: https://resend.com
RESEND_API_KEY="re_sample_api_key"
RESEND_FROM_EMAIL="notifikasi@irodori-portal.com"

# 4. OBJECT STORAGE (Cloudflare R2 - S3 Compatible)
# Dapatkan dari: https://dash.cloudflare.com -> R2 Object Storage
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="irodori-assets"
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-sample.r2.dev"

# 5. APP URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
